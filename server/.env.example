# Copy this file to server/.env and replace placeholders with your real values.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
APP_API_KEY=replace_with_a_secure_random_value
TV_WEBHOOK_SECRET=replace_with_a_secure_random_value
PORT=8080
PUBLIC_BASE_URL=https://YOUR_DOMAIN
DEFAULT_RISK_PERCENT=0.5
MAX_OPEN_POSITIONS=3
# Empty TELEGRAM_CHAT_ID: the first person to send /start becomes owner.
# Never share provider keys in chat.
OPENAI_API_KEY_1=replace_with_your_openai_api_key
GEMINI_API_KEY=replace_with_your_gemini_api_key
AI_ENABLED=true
AI_REQUIRED=true
OPENAI_MODEL_1=gpt-5-mini
GEMINI_MODEL=gemini-2.5-flash
AI_MIN_CONFIDENCE=70

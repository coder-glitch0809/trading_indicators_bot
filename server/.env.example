# Copy this file to server/.env for local development. Do not commit server/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_API_KEY=
TV_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://YOUR_DOMAIN

# AI reviewers: all configured and enabled reviewers must approve a signal.
AI_ENABLED=true
AI_REQUIRED=true
AI_MIN_CONFIDENCE=70
OPENAI_API_KEY_1=
OPENAI_MODEL_1=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude / Anthropic Messages API.
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# Signal and risk policy.
SIGNAL_TTL_MINUTES=30
MIN_RISK_REWARD=1.2
DEFAULT_RISK_PERCENT=0.5
